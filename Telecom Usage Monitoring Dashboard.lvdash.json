{
  "datasets": [
    {
      "name": "subscriber_usage",
      "displayName": "Subscriber Usage Metrics",
      "config": {
        "version": "1.1",
        "source": "gold_subscriber_usage",
        "dimensions": [
          {
            "name": "subscriber_id",
            "expr": "subscriber_id",
            "comment": "Unique subscriber identifier"
          },
          {
            "name": "last_event_time",
            "expr": "last_event_time",
            "comment": "Timestamp of most recent activity",
            "format": {
              "type": "date_time",
              "dateFormat": "locale_short_month",
              "timeFormat": "locale_hour_minute"
            }
          }
        ],
        "measures": [
          {
            "displayName": "Total Calls",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "total_calls",
            "expr": "SUM(total_calls)",
            "comment": "Number of voice calls made"
          },
          {
            "displayName": "Total Call Duration (sec)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "total_call_duration",
            "expr": "SUM(total_call_duration_sec)",
            "comment": "Total duration of all calls in seconds"
          },
          {
            "displayName": "Total Data Sessions",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "total_data_sessions",
            "expr": "SUM(total_data_sessions)",
            "comment": "Number of data usage sessions"
          },
          {
            "displayName": "Total Data Usage (MB)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "total_data_mb",
            "expr": "SUM(total_data_mb)",
            "comment": "Total data consumed in megabytes"
          },
          {
            "displayName": "Total SMS",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "total_sms",
            "expr": "SUM(total_sms)",
            "comment": "Number of SMS messages sent"
          },
          {
            "displayName": "Total Events",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "total_events",
            "expr": "SUM(total_events)",
            "comment": "Total number of all events"
          },
          {
            "displayName": "Avg Call Duration (sec)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "avg_call_duration",
            "expr": "SUM(total_call_duration_sec) / NULLIF(SUM(total_calls), 0)",
            "comment": "Average duration per call"
          }
        ]
      }
    },
    {
      "name": "event_details",
      "displayName": "Event Details",
      "config": {
        "version": "1.1",
        "source": "telecom_silver",
        "dimensions": [
          {
            "name": "event_id",
            "expr": "event_id",
            "comment": "Unique event identifier"
          },
          {
            "name": "subscriber_id",
            "expr": "subscriber_id",
            "comment": "Subscriber identifier"
          },
          {
            "name": "event_type",
            "expr": "event_type",
            "comment": "Type of event - CALL, DATA, or SMS"
          },
          {
            "name": "cell_tower_id",
            "expr": "cell_tower_id",
            "comment": "Cell tower handling the event"
          },
          {
            "name": "event_timestamp",
            "expr": "event_timestamp",
            "comment": "When the event occurred",
            "format": {
              "type": "date_time",
              "dateFormat": "locale_short_month",
              "timeFormat": "locale_hour_minute"
            }
          },
          {
            "displayName": "Event Date",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            },
            "name": "event_date",
            "expr": "DATE(event_timestamp)",
            "comment": "Date of event"
          },
          {
            "name": "event_hour",
            "expr": "HOUR(event_timestamp)",
            "displayName": "Event Hour",
            "comment": "Hour of day when event occurred"
          }
        ],
        "measures": [
          {
            "displayName": "Call Duration (sec)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "call_duration",
            "expr": "SUM(call_duration_sec)",
            "comment": "Total call duration in seconds"
          },
          {
            "displayName": "Data Usage (MB)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "data_usage",
            "expr": "SUM(data_used_mb)",
            "comment": "Total data consumed in megabytes"
          },
          {
            "displayName": "SMS Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "sms_count",
            "expr": "SUM(sms_count)",
            "comment": "Number of SMS messages"
          },
          {
            "displayName": "Event Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "event_count",
            "expr": "COUNT(*)",
            "comment": "Total number of events"
          }
        ]
      }
    },
    {
      "name": "tower_load",
      "displayName": "Tower Load Metrics",
      "config": {
        "version": "1.1",
        "source": "gold_tower_load",
        "dimensions": [
          {
            "name": "cell_tower_id",
            "expr": "cell_tower_id",
            "comment": "Cell tower identifier"
          }
        ],
        "measures": [
          {
            "displayName": "Total Events",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "event_count",
            "expr": "SUM(event_count)",
            "comment": "Total events handled by tower"
          },
          {
            "displayName": "Data Traffic (MB)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "total_data_mb",
            "expr": "SUM(total_data_mb)",
            "comment": "Total data traffic through tower"
          },
          {
            "displayName": "Call Duration (sec)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            },
            "name": "total_call_duration",
            "expr": "SUM(total_call_duration_sec)",
            "comment": "Total call duration on tower"
          }
        ]
      }
    },
    {
      "name": "top10_data_subscribers",
      "displayName": "Top 10 Subscribers by Data",
      "config": {
        "version": "1.1",
        "source": "SELECT subscriber_id, total_data_mb, total_calls, total_call_duration_sec, total_sms, total_events FROM gold_subscriber_usage ORDER BY total_data_mb DESC LIMIT 10\n",
        "dimensions": [
          {
            "name": "subscriber_id",
            "expr": "subscriber_id",
            "comment": "Unique subscriber identifier"
          }
        ],
        "measures": [
          {
            "displayName": "Total Data Usage (MB)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "total_data_mb",
            "expr": "SUM(total_data_mb)",
            "comment": "Total data consumed in megabytes"
          }
        ]
      }
    },
    {
      "name": "top10_call_subscribers",
      "displayName": "Top 10 Subscribers by Call Duration",
      "config": {
        "version": "1.1",
        "source": "SELECT subscriber_id, total_data_mb, total_calls, total_call_duration_sec, total_sms, total_events FROM gold_subscriber_usage ORDER BY total_call_duration_sec DESC LIMIT 10\n",
